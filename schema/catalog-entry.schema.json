{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuperiorSoft-LLC/infantry-plugins/schema/catalog-entry.schema.json",
  "title": "CatalogEntry",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": ["string", "null"], "description": "SPDX id. Missing = validation warning." },
    "homepage": { "type": ["string", "null"] },
    "repo": { "type": ["string", "null"], "pattern": "^[^/\s]+/[^/\s]+$", "description": "owner/name on GitHub; every version url must be under https://github.com/<repo>/releases/." },
    "versions": { "type": "array", "items": { "$ref": "#/$defs/CatalogVersion" } }
  },
  "$defs": {
    "ApiRanges": {
      "type": "object",
      "properties": {
        "plugin": { "type": ["string", "null"] },
        "daemon": { "type": ["string", "null"] },
        "harness": { "type": ["string", "null"] }
      }
    },
    "CatalogVersion": {
      "type": "object",
      "required": ["version", "url", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "api": { "$ref": "#/$defs/ApiRanges" },
        "grants": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string", "pattern": "^https://" },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signer": { "type": ["string", "null"] },
        "published": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "yanked": { "type": "boolean", "default": false },
        "yankedReason": { "type": ["string", "null"] }
      }
    }
  }
}
