{
  "name": "Infantry_Sites",
  "version": "1.1.0",
  "apiVersion": 2,
  "author": "Infantry AI",
  "license": "Apache-2.0",
  "description": "Infantry AI Hosting: your hosting servers (read-only list) and SSH for agents. A native sidecar and a client of the WebServices API; no secrets live in it.",
  "tier": "official",
  "sequence": [],
  "daemon": {
    "sidecar": {
      "exe": "bin/infantry-sites",
      "args": [
        "--stdio"
      ]
    },
    "apiAtLeast": "0.1.0",
    "needs": [
      "frames",
      "http",
      "storage"
    ],
    "wants": [
      "settings",
      "config"
    ],
    "tools": [
      {
        "name": "infantry_sites_list",
        "action": "sites.servers.read",
        "kind": "read",
        "description": "List your hosting servers (id, name, status, sshReady, ip, region, size, createdAt, destroyAt)."
      },
      {
        "name": "infantry_sites_ssh_exec",
        "action": "sites.servers.ssh",
        "kind": "write",
        "description": "Run a shell command on one of your hosting servers over SSH (args: server?, command, timeoutSec?)."
      },
      {
        "name": "infantry_sites_ssh_upload",
        "action": "sites.servers.ssh",
        "kind": "write",
        "description": "Write a small text file on one of your hosting servers over SSH (args: server?, path, content)."
      }
    ],
    "frames": [
      {
        "type": "sites_list",
        "action": "sites.servers.read",
        "description": "The Sites panel: {} -> sites_list {state, message?, servers?, limit?, siteUrl?, signUpUrl?, planStatus?, reclaimableUntil?}"
      },
      {
        "type": "sites_ssh_exec",
        "action": "sites.servers.ssh",
        "kind": "write",
        "description": "{server?, command, timeoutSec?} -> sites_ssh_exec {server, exitCode?, stdout, stderr, truncated?, timedOut?} (owner only)"
      },
      {
        "type": "sites_ssh_upload",
        "action": "sites.servers.ssh",
        "kind": "write",
        "description": "{server?, path, content} -> sites_ssh_upload {server, exitCode?, stdout, stderr} (owner only)"
      }
    ],
    "endpoints": {
      "api": {
        "prod": "https://superiorsoftllc.tech/api/superiorsoft",
        "dev": "http://127.0.0.1:18953/api/superiorsoft",
        "staging": "http://127.0.0.1:18953/api/superiorsoft"
      },
      "site": {
        "prod": "https://superiorsoftllc.tech",
        "dev": "http://127.0.0.1:18953",
        "staging": "http://localhost:5173"
      }
    },
    "config": [
      {
        "node": "Infantry_Sites.ssh",
        "group": "Hosting",
        "title": "SSH for agents",
        "tab": "Plugins",
        "order": 980,
        "applies": "Applies to: the infantry_sites_ssh_exec tool and the Sites panel's SSH command.",
        "keywords": [
          "ssh",
          "hosting",
          "server",
          "exec",
          "timeout",
          "output"
        ],
        "fields": [
          {
            "key": "limits.sites.ssh.outputBytes",
            "type": "number",
            "label": "Most output kept per stream (bytes; the rest is cut and the answer says truncated)",
            "default": 65536,
            "min": 1024,
            "max": 10485760,
            "step": 1,
            "scope": "daemon",
            "order": 1
          },
          {
            "key": "limits.sites.ssh.connectTimeoutSec",
            "type": "number",
            "label": "Connect and sign-in timeout (seconds)",
            "default": 15,
            "min": 1,
            "max": 300,
            "step": 1,
            "scope": "daemon",
            "order": 2
          },
          {
            "key": "limits.sites.ssh.commandTimeoutSec",
            "type": "number",
            "label": "Command timeout when the call names none (seconds)",
            "default": 60,
            "min": 1,
            "max": 3600,
            "step": 1,
            "scope": "daemon",
            "order": 3
          },
          {
            "key": "limits.sites.ssh.maxCommandTimeoutSec",
            "type": "number",
            "label": "Longest command timeout a call may ask for (seconds)",
            "default": 600,
            "min": 1,
            "max": 86400,
            "step": 1,
            "scope": "daemon",
            "order": 4
          },
          {
            "key": "limits.sites.ssh.certMarginSec",
            "type": "number",
            "label": "Ask for a new SSH certificate this long before the old one ends (seconds)",
            "default": 60,
            "min": 0,
            "max": 3600,
            "step": 1,
            "scope": "daemon",
            "order": 5
          },
          {
            "key": "limits.sites.ssh.retryAfterSec",
            "type": "number",
            "label": "Retry hint when the server is still being set up and the API gives none (seconds)",
            "default": 15,
            "min": 1,
            "max": 3600,
            "step": 1,
            "scope": "daemon",
            "order": 6
          }
        ]
      }
    ]
  },
  "tabs": [
    {
      "id": "infantry.sites",
      "container": "center"
    }
  ],
  "account": {
    "providers": [
      {
        "id": "infantry",
        "name": "Infantry AI Hosting",
        "icon": "cloud",
        "signIn": {
          "method": "device_code",
          "clientId": "infantry-app",
          "scopes": [
            "account",
            "hosting"
          ],
          "deviceAuthorizationUrl": "{api}/auth/oauth/device/code",
          "tokenUrl": "{api}/auth/oauth/token",
          "revokeUrl": "{api}/auth/oauth/revoke"
        },
        "accountUrl": "{api}/core/v1/account",
        "billingUrl": "{site}/account/billing",
        "signUpUrl": "{site}/plans",
        "services": [
          {
            "id": "hosting",
            "name": "Hosting",
            "entitlement": "hosting.servers.read",
            "section": "infantry.sites"
          }
        ],
        "consumers": [
          "Infantry_Sites"
        ]
      }
    ]
  }
}
